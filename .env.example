# Optionnel — carte partagée. Sans ces deux valeurs, l'app utilise le stockage
# du téléphone (localStorage) et se comporte comme le prototype local.
# Le SQL à lancer une fois est dans supabase/schema.sql. Voir le README.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optionnel — vidéo d'alerte (MP4/WebM déjà en ligne).
# Sinon, déposer src/assets/alerte.mp4 (ou .webm) avant le build.
VITE_ALERT_VIDEO_URL=
